# ============================================================
# Cloud Native E-commerce Platform
# Root environment file for Docker Compose.
#
# Copy this file to `.env` and adjust the values as needed:
#   cp .env.example .env
#
# `docker compose` automatically reads the `.env` file next to
# docker-compose.yml and substitutes the ${VAR} references below.
#
# For Kubernetes deployments the same values are provided by the
# `ecommerce-secrets` Secret (gitops/secrets.yml).
# ============================================================

# --- PostgreSQL (docker-compose `postgres` service) ---
POSTGRES_DB=fashion_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Per-service database connection URLs ---
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
AUTH_DB_URL=postgresql://postgres:postgres123@postgres:5432/auth_db
PRODUCTS_DB_URL=postgresql://postgres:postgres123@postgres:5432/products_db
ORDERS_DB_URL=postgresql://postgres:postgres123@postgres:5432/orders_db
USERS_DB_URL=postgresql://postgres:postgres123@postgres:5432/users_db

# --- Auth / JWT ---
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN=3600

# --- Port the services listen on inside the container ---
SERVICE_PORT=8000

# --- Inter-service URLs (docker-compose service names) ---
AUTH_URL=http://fashion-ecommerce-auth:8000
PRODUCTS_URL=http://fashion-ecommerce-products:8000
ORDERS_URL=http://fashion-ecommerce-orders:8000
USERS_URL=http://fashion-ecommerce-users:8000
AUTH_SERVICE_URL=http://fashion-ecommerce-auth:8000
PRODUCT_SERVICE_URL=http://fashion-ecommerce-products:8000

# --- Frontend ---
REACT_APP_API_URL=http://localhost:3001/api