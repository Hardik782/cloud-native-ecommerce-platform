# ==========================================================
# Gateway Service - environment variables
# Copy this file to `.env` and adjust the values (local dev).
#
# In Docker, values are injected from the root `.env` file
# (see docker-compose.yml). In Kubernetes they come from the
# `ecommerce-secrets` Secret (see gitops/secrets.yml).
# ==========================================================

# Service
SERVICE_NAME=gateway
SERVICE_PORT=8000

# Upstream service URLs (docker-compose service names / k8s Service DNS)
AUTH_URL=http://fashion-ecommerce-auth:8000
PRODUCTS_URL=http://fashion-ecommerce-products:8000
ORDERS_URL=http://fashion-ecommerce-orders:8000
USERS_URL=http://fashion-ecommerce-users:8000
