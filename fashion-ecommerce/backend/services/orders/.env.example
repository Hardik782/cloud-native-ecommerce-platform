# ==========================================================
# Order Service - environment variables
# Copy this file to `.env` and adjust the values (local dev).
#
# In Docker, values are injected from the root `.env` file
# (see docker-compose.yml). In Kubernetes they come from the
# `ecommerce-secrets` Secret (see gitops/secrets.yml).
# ==========================================================

# Service
SERVICE_NAME=orders
SERVICE_PORT=8000

# Database connection string (postgresql://user:password@host:port/database)
DATABASE_URL=postgresql://postgres:postgres123@postgres:5432/orders_db

# Upstream services
AUTH_SERVICE_URL=http://fashion-ecommerce-auth:8000
PRODUCT_SERVICE_URL=http://fashion-ecommerce-products:8000
